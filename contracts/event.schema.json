{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymas.local/schemas/event-0.1.0.json",
  "title": "PolyMAS normalized event envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "streamId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "attemptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){1,4}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "control",
            "worker",
            "codex",
            "mcp"
          ]
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "sourceType"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "streamId",
    "sequence",
    "timestamp",
    "observedAt",
    "workspaceId",
    "runId",
    "taskId",
    "agentId",
    "attemptId",
    "correlationId",
    "causationId",
    "type",
    "source",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.state.changed"
          }
        }
      },
      "then": {
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "enum": [
                  "configured",
                  "idle",
                  "queued",
                  "starting",
                  "running",
                  "tool_wait",
                  "waiting_message",
                  "waiting_user",
                  "rate_limited",
                  "paused",
                  "stopping",
                  "stopped",
                  "failed",
                  "archived",
                  "stale"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.delivered"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "messageId": {
                "type": "string",
                "format": "uuid"
              },
              "fromAgentId": {
                "type": "string",
                "minLength": 1
              },
              "toAgentId": {
                "type": "string",
                "minLength": 1
              },
              "deliveryState": {
                "const": "delivered_to_context"
              },
              "bodyPreview": {
                "type": "string",
                "maxLength": 500
              },
              "recipientAttemptId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "messageId",
              "fromAgentId",
              "toAgentId",
              "deliveryState",
              "bodyPreview",
              "recipientAttemptId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp.call.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "callId": {
                "type": "string",
                "minLength": 1
              },
              "connectionId": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "cancelled",
                  "unknown"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              },
              "artifactRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              }
            },
            "required": [
              "callId",
              "connectionId",
              "tool",
              "status",
              "durationMs",
              "artifactRefs"
            ]
          }
        }
      }
    }
  ]
}

